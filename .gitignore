# ===============================
# Python artifacts
# ===============================
__pycache__/
*.py[cod]
*.so
*.egg-info/

# ===============================
# Jupyter notebooks
# ===============================
.ipynb_checkpoints/

# ===============================
# Environment files
# ===============================
.env
*.env
.venv/
.ollama_env/
ollama_env/

# ===============================
# VSCode / IDEs
# ===============================
.vscode/
.idea/
*.swp

# ===============================
# Data & Models
# ===============================
data/*
models/*

# Exceptions (files you still want to track)
!data/vector_store/index.pkl
!data/vector_store/index.faiss

# Explicitly ignore these specific subfolders in data/
data/library/
data/library2/
data/tables/db_permuted/
data/training_dataset/

# Allow other files in data/ if needed
!data/**/*.py

# ===============================
# Checkpoints / Logs / Outputs
# ===============================
logs/
*.log
*.out
*.pth
*.ckpt

# ===============================
# Training outputs & scripts
# ===============================
scripts/train/train_model/
source/training/

# ===============================
# Misc
# ===============================
.DS_Store